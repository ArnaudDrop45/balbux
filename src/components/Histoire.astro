---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id="histoire"
  class="py-20 lg:py-28 bg-cream-sand border-t border-stone-200/80"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Story Text -->
      <div class="space-y-6">
        <span class="text-xs tracking-[0.25em] font-bold text-gold-dark uppercase"
          >{t("histoire.tag")}</span
        >
        <h2
          class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-balbux-deep leading-tight"
        >
          {t("histoire.title")}
        </h2>
        <p class="text-lg text-slate-stone font-medium leading-relaxed">
          {t("histoire.lead")}
        </p>
        <div class="h-1 w-16 bg-gold-badge rounded-full"></div>
        <div
          class="space-y-4 text-sm sm:text-base text-slate-stone font-light leading-relaxed"
        >
          <p set:html={t("histoire.p1")} />
          <p>{t("histoire.p2")}</p>
          <p>{t("histoire.p3")}</p>
        </div>
      </div>

      <!-- Right: Global Routes Image -->
      <div>
        <div
          class="relative rounded-3xl overflow-hidden shadow-xl border border-stone-200/90 bg-white/70 p-2 sm:p-3 group"
        >
          <img
            src="/images/global_routes.png"
            alt={t("histoire.img1.alt")}
            class="w-full h-auto object-contain rounded-2xl group-hover:scale-102 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
