---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="histoire" class="relative overflow-hidden py-20 lg:py-28 bg-cream-sand border-t border-stone-200/80">
  <!-- Background Image 100vw -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <img
      src="/images/global_routes.png"
      alt={t("histoire.img1.alt")}
      class="w-full h-full object-contain object-center lg:object-right"
      loading="lazy"
    />
    <!-- Subtle natural lighting overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-cream-sand/40 via-transparent to-cream-sand/20"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Text Section wrapped in a frosted card like Hero -->
    <div class="max-w-2xl lg:max-w-3xl p-6 sm:p-10 rounded-3xl bg-white/92 backdrop-blur-md border border-white/80 shadow-2xl space-y-6">
      <span
        class="text-xs tracking-[0.25em] font-bold text-gold-dark uppercase"
        >{t("histoire.tag")}</span
      >
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-balbux-deep leading-tight"
      >
        {t("histoire.title")}
      </h2>
      <p class="text-lg text-slate-stone font-medium leading-relaxed">
        {t("histoire.lead")}
      </p>
      <div class="h-1 w-16 bg-gold-badge rounded-full"></div>
      <div
        class="space-y-4 text-sm sm:text-base text-slate-stone font-light leading-relaxed"
      >
        <p set:html={t("histoire.p1")} />
        <p>{t("histoire.p2")}</p>
        <p>{t("histoire.p3")}</p>
      </div>
    </div>
  </div>
</section>
