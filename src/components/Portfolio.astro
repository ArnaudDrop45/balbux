---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const categories = [
  {
    num: "01",
    title: t("portfolio.cat1.title"),
    itemsText: t("portfolio.cat1.items"),
    accent: "text-balbux-accent",
    dot: "bg-balbux-accent",
    border: "hover:border-balbux-accent/50",
    icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
  },
  {
    num: "02",
    title: t("portfolio.cat2.title"),
    itemsText: t("portfolio.cat2.items"),
    accent: "text-gold-dark",
    dot: "bg-gold-dark",
    border: "hover:border-gold-dark/50",
    icon: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    num: "03",
    title: t("portfolio.cat3.title"),
    itemsText: t("portfolio.cat3.items"),
    accent: "text-balbux-forest",
    dot: "bg-balbux-forest",
    border: "hover:border-balbux-forest/50",
    icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
  },
  {
    num: "04",
    title: t("portfolio.cat4.title"),
    itemsText: t("portfolio.cat4.items"),
    accent: "text-balbux-deep",
    dot: "bg-balbux-deep",
    border: "hover:border-balbux-deep/50",
    icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
  },
];
---

<section
  id="portfolio"
  class="py-20 lg:py-24 bg-white border-b border-stone-200/80 scroll-mt-16"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-14 space-y-4">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cream-sand border border-stone-200/90 text-xs font-semibold tracking-wider text-gold-dark uppercase shadow-2xs"
      >
        <span class="w-2 h-2 rounded-full bg-balbux-accent animate-pulse"
        ></span>
        <span>{t("portfolio.tag")}</span>
      </div>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold text-balbux-deep tracking-tight"
      >
        {t("portfolio.title")}
      </h2>
      <div class="h-1 w-16 bg-gold-badge rounded-full mx-auto"></div>
      <p
        class="text-base sm:text-lg text-slate-stone font-light leading-relaxed max-w-2xl mx-auto pt-1"
      >
        {t("portfolio.lead")}
      </p>
    </div>

    <!-- Product Showcase Image -->
    <div
      class="relative rounded-3xl overflow-hidden shadow-2xl border border-stone-200/90 bg-white mb-14 group"
    >
      <img
        src="/images/products.jpg"
        alt={t("portfolio.img.alt")}
        class="w-full h-auto object-cover group-hover:scale-[1.01] transition-transform duration-500"
        loading="lazy"
      />
    </div>

    <!-- 4 Portfolio Categories Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        categories.map((cat) => (
          <div
            class={`p-7 rounded-3xl bg-cream-sand/50 border border-stone-200/90 ${cat.border} transition-all duration-300 shadow-2xs hover:shadow-md hover:bg-white flex flex-col justify-between group`}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span
                  class={`text-xs font-mono font-bold tracking-widest ${cat.accent}`}
                >
                  {cat.num}
                </span>
                <div class="w-9 h-9 rounded-2xl bg-white border border-stone-200/80 shadow-2xs flex items-center justify-center text-slate-charcoal group-hover:scale-110 transition-transform">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d={cat.icon}
                    />
                  </svg>
                </div>
              </div>

              <div>
                <h3 class="text-base font-serif font-bold text-balbux-deep tracking-tight mb-2">
                  {cat.title}
                </h3>
                <p class="text-xs text-slate-stone leading-relaxed font-light">
                  {cat.itemsText}
                </p>
              </div>
            </div>

            <div class="pt-4 border-t border-stone-200/70 mt-4 flex items-center gap-2">
              <span class={`w-1.5 h-1.5 rounded-full ${cat.dot}`} />
              <span class="text-[11px] font-semibold text-slate-charcoal uppercase tracking-wider">
                BalBux Selection
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
