---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div 
  id="toast" 
  data-prefix={t('toast.copied')} 
  class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 px-4 py-3 rounded-xl bg-balbux-deep text-white text-xs font-semibold shadow-xl border border-white/10 flex items-center gap-2 pointer-events-none"
>
  <span class="text-gold-badge font-bold">✓</span>
  <span id="toastMessage">{t('toast.copied')}</span>
</div>

<script is:inline>
  window.showToast = function(message) {
    const toast = document.getElementById('toast');
    const toastMessage = document.getElementById('toastMessage');
    if (!toast || !toastMessage) return;
    toastMessage.innerText = message;
    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    
    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-20', 'opacity-0');
    }, 2500);
  };

  window.copyToClipboard = function(text, btnElement) {
    const tempInput = document.createElement('input');
    tempInput.style.position = 'absolute';
    tempInput.style.left = '-9999px';
    tempInput.value = text;
    document.body.appendChild(tempInput);
    tempInput.select();
    
    const toastEl = document.getElementById('toast');
    const prefix = toastEl?.getAttribute('data-prefix') || 'Email copié : ';

    try {
      document.execCommand('copy');
      window.showToast(`${prefix}${text}`);
      if (btnElement) {
        const originalText = btnElement.innerText;
        const copiedLabel = btnElement.getAttribute('data-copied-text') || '✓';
        btnElement.innerText = copiedLabel;
        btnElement.classList.add('bg-balbux-soft', 'text-balbux-deep');
        setTimeout(() => {
          btnElement.innerText = originalText;
          btnElement.classList.remove('bg-balbux-soft', 'text-balbux-deep');
        }, 2000);
      }
    } catch (err) {
      console.error('Erreur lors de la copie', err);
    } finally {
      document.body.removeChild(tempInput);
    }
  };
</script>
