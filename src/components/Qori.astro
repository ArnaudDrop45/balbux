---
---

<section id="qori" class="py-24 bg-cream-sand/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="max-w-3xl mb-16">
      <span class="text-xs uppercase tracking-[0.25em] font-bold text-gold-dark">Référence Phare</span>
      <h2 class="text-3xl sm:text-5xl font-serif font-bold text-balbux-deep mt-2">
        QŌRI · Pâtes avec 75% de Quinoa Bio
      </h2>
      <p class="text-base text-slate-stone mt-4">
        Une alternative gourmet, sans gluten et riche en protéines pour les consommateurs modernes qui recherchent une nutrition authentique sans sacrifier la texture ni la saveur.
      </p>
    </div>

    <!-- Product Range Global Display -->
    <div class="w-full mb-16 rounded-3xl overflow-hidden shadow-lg border border-stone-200">
      <img src="/images/products_display.jpg" alt="Vue d'ensemble de la gamme de produits BalBux" class="w-full h-auto object-cover" loading="lazy" />
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-center">
      
      <!-- Product Showcase Card -->
      <div class="lg:col-span-6 bg-white p-8 sm:p-10 rounded-3xl border border-stone-200 custom-shadow">
        <div class="flex items-center justify-between pb-6 border-b border-stone-200">
          <div>
            <span class="text-xs font-bold text-balbux-accent tracking-wider uppercase">Lancement Retail</span>
            <h3 class="text-2xl font-serif font-bold text-balbux-deep">Gamme QŌRI 250 g</h3>
          </div>
          <span class="px-3 py-1 rounded-full bg-balbux-soft text-balbux-deep font-semibold text-xs border border-balbux-forest/10">
            Format 250g
          </span>
        </div>

        <div class="py-8 space-y-6">
          <!-- Product Variants list -->
          <div class="grid sm:grid-cols-2 gap-4">
            <!-- Variant 1 -->
            <div class="p-4 rounded-xl bg-cream-sand border border-stone-200 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-amber-100 border border-amber-300 flex items-center justify-center text-xs">🌾</div>
              <div>
                <h4 class="text-sm font-bold text-balbux-deep">Quinoa Blanche</h4>
                <p class="text-xs text-slate-stone">Saveur douce et texture al dente</p>
              </div>
            </div>

            <!-- Variant 2 -->
            <div class="p-4 rounded-xl bg-cream-sand border border-stone-200 flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-amber-800/20 border border-amber-800/40 flex items-center justify-center text-xs">🍂</div>
              <div>
                <h4 class="text-sm font-bold text-balbux-deep">Quinoa Tricolore</h4>
                <p class="text-xs text-slate-stone">Mélange blanc, rouge et noir</p>
              </div>
            </div>
          </div>

          <!-- Features -->
          <ul class="space-y-3 text-sm text-slate-stone pt-2">
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-balbux-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span><strong class="font-semibold text-balbux-deep">75% de quinoa andine bio</strong> certifiée</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-balbux-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Profil complet en acides aminés essentiels</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class="w-5 h-5 text-balbux-accent flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Conditionné et prêt pour la distribution en GMS et réseau bio</span>
            </li>
          </ul>
        </div>

        <div class="pt-6 border-t border-stone-200 flex flex-wrap gap-4 items-center justify-between">
          <span class="text-xs text-slate-stone">Fiche technique et échantillons sur demande.</span>
          <a href="#contacto" class="text-xs font-bold uppercase tracking-wider text-balbux-deep hover:text-balbux-accent transition-colors underline">
            Demander des échantillons &rarr;
          </a>
        </div>
      </div>

      <!-- Product Specs & Retail positioning -->
      <div class="lg:col-span-6 space-y-6">
        <div class="p-8 rounded-3xl bg-white border border-stone-200 shadow-sm">
          <h4 class="text-lg font-serif font-bold text-balbux-deep mb-4">Pourquoi QŌRI dans votre rayon ?</h4>
          <div class="space-y-4 text-sm text-slate-stone">
            <div class="p-4 rounded-xl bg-balbux-soft/40 border-l-4 border-balbux-emerald">
              <h5 class="font-bold text-balbux-deep">Différenciation immédiate</h5>
              <p class="text-xs mt-1">Le consommateur européen cherche à réduire le gluten sans recourir aux farines raffinées ou ultra-transformées. QŌRI offre une densité nutritionnelle pure.</p>
            </div>
            <div class="p-4 rounded-xl bg-balbux-soft/40 border-l-4 border-gold-badge">
              <h5 class="font-bold text-balbux-deep">Rotation et marges saines</h5>
              <p class="text-xs mt-1">Format premium conçu pour des achats d'impulsion réfléchis dans les segments Bio, Gourmet et Alimentation Santé.</p>
            </div>
            <div class="p-4 rounded-xl bg-balbux-soft/40 border-l-4 border-balbux-accent">
              <h5 class="font-bold text-balbux-deep">Storytelling vérifiable</h5>
              <p class="text-xs mt-1">Chaque lot bénéficie d'une traçabilité géographique andine, renforçant la fidélisation du consommateur engagé.</p>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
