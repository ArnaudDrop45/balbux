---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-balbux-deep text-stone-300 border-t border-balbux-forest py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10">
      
      <a href="#hero" class="flex items-center group">
        <img 
          src="/images/logo-balbux.webp" 
          alt="BalBux - Scaling Brands in Europe" 
          class="h-10 w-auto object-contain rounded-lg group-hover:opacity-90 transition-opacity" 
        />
      </a>

      <p class="text-xs uppercase tracking-[0.25em] font-medium text-gold-badge">
        {t('footer.claim')}
      </p>

      <div class="flex items-center gap-6 text-xs text-stone-400">
        <a href="#hero" class="hover:text-white transition-colors duration-200">{t('footer.nav.home')}</a>
        <a href="#histoire" class="hover:text-white transition-colors duration-200">{t('footer.nav.histoire')}</a>
        <a href="#vision" class="hover:text-white transition-colors duration-200">{t('footer.nav.vision')}</a>
        <a href="#qori" class="hover:text-white transition-colors duration-200">{t('footer.nav.qori')}</a>
        <a href="#contact" class="hover:text-white transition-colors duration-200">{t('footer.nav.contact')}</a>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-stone-400">
      <p>{t('footer.rights')}</p>
      <p>189 route de Lyon, 38390 Porcieu-Amblagnieu, France · SIREN 824 597 819</p>
    </div>
  </div>
</footer>
