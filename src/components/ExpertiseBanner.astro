---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-12 bg-cream-sand">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Expertise Banner -->
    <div
      class="bg-balbux-deep text-white rounded-3xl p-10 sm:p-12 shadow-2xl relative overflow-hidden"
    >
      <div
        class="absolute -right-20 -top-20 w-64 h-64 bg-balbux-forest rounded-full blur-3xl opacity-50 pointer-events-none"
      >
      </div>

      <div class="grid lg:grid-cols-12 gap-10 items-center relative z-10">
        <div class="lg:col-span-5 space-y-5">
          <h3 class="text-2xl font-serif font-bold text-gold-light">
            {t("histoire.banner.title")}
          </h3>
          <p class="text-sm text-stone-200 font-light leading-relaxed">
            {t("histoire.banner.text")}
          </p>
        </div>
        <div class="lg:col-span-7">
          <div
            class="p-6 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-sm"
          >
            <h4
              class="text-xs uppercase tracking-widest text-gold-badge font-bold mb-4"
            >
              {t("histoire.banner.badge")}
            </h4>
            <div
              class="flex flex-wrap items-center gap-2 text-[10px] sm:text-xs font-semibold text-white tracking-wider"
            >
              <span>{t("histoire.step.selection")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.development")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.importation")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.compliance")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.distribution")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.retail")}</span>
              <span class="text-balbux-accent">→</span>
              <span>{t("histoire.step.marketing")}</span>
              <span class="text-balbux-accent">→</span>
              <span class="text-gold-light">{t("histoire.step.growth")}</span>
            </div>
            <p class="text-xs text-stone-300 mt-4 leading-relaxed font-light">
              {t("histoire.banner.footer")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
