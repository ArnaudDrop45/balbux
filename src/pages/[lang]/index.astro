---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import Histoire from "../../components/Histoire.astro";
import ExpertiseBanner from "../../components/ExpertiseBanner.astro";
import Ambition from "../../components/Ambition.astro";
import Vision from "../../components/Vision.astro";
import QueHacemos from "../../components/QueHacemos.astro";
import ParaQuienTrabajamos from "../../components/ParaQuienTrabajamos.astro";
import EuropeanGateway from "../../components/EuropeanGateway.astro";
import Portfolio from "../../components/Portfolio.astro";
import Qori from "../../components/Qori.astro";
import Contacto from "../../components/Contacto.astro";
import Footer from "../../components/Footer.astro";
import type { Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
---

<Layout lang={lang}>
	<Header />
	<main class="flex-grow">
		<Hero />
		<Histoire />
		<ExpertiseBanner />
		<Ambition />
		<Vision />
		<QueHacemos />
		<ParaQuienTrabajamos />
		<EuropeanGateway />
		<Portfolio />
		<Qori />
		<Contacto />
	</main>
	<Footer />
</Layout>
