---
import '../styles/global.css';
import Toast from '../components/Toast.astro';
import Analytics from '@vercel/analytics/astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalURL?: string;
	lang?: Lang;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const {
	title = t('meta.title'),
	description = t('meta.description'),
	image = '/images/default-og.png',
	canonicalURL = Astro.url.href,
} = Astro.props;

const origin = Astro.site ? Astro.site.origin : Astro.url.origin;
const localeMap = {
	fr: 'fr_FR',
	es: 'es_ES',
	en: 'en_US',
};

const schema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": ["LocalBusiness", "Organization"],
			"@id": `${origin}/#localbusiness`,
			"name": "BALBUX",
			"legalName": "BALBUX",
			"url": origin,
			"logo": `${origin}/images/logo-balbux.webp`,
			"image": `${origin}/images/contact.webp`,
			"description": description,
			"foundingDate": "2016-12-27",
			"taxID": "824 597 819",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "189 route de Lyon",
				"addressLocality": "Porcieu-Amblagnieu",
				"postalCode": "38390",
				"addressRegion": "Auvergne-Rhône-Alpes",
				"addressCountry": "FR"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": "45.8341",
				"longitude": "5.4014"
			},
			"founder": [
				{
					"@type": "Person",
					"name": "Jean Buxassa",
					"jobTitle": "Co-fondateur",
					"email": "jean.buxassa@balbux.com"
				},
				{
					"@type": "Person",
					"name": "Roberto Balcázar",
					"jobTitle": "Co-fondateur",
					"email": "roberto.balcazar@balbux.com"
				}
			],
			"contactPoint": [
				{
					"@type": "ContactPoint",
					"contactType": "sales",
					"email": "jean.buxassa@balbux.com",
					"availableLanguage": ["French", "Spanish", "English"]
				},
				{
					"@type": "ContactPoint",
					"contactType": "customer service",
					"email": "roberto.balcazar@balbux.com",
					"availableLanguage": ["Spanish", "French", "English"]
				}
			],
			"knowsAbout": [
				"Importation agroalimentaire",
				"Superaliments des Andes",
				"Quinoa biologique",
				"Distribution retail Europe",
				"Gamme QŌRI"
			]
		},
		{
			"@type": "WebSite",
			"@id": `${origin}/#website`,
			"url": origin,
			"name": "BalBux",
			"description": description,
			"publisher": {
				"@id": `${origin}/#localbusiness`
			},
			"inLanguage": ["fr", "es", "en"]
		},
		{
			"@type": "WebPage",
			"@id": `${canonicalURL}#webpage`,
			"url": canonicalURL,
			"name": title,
			"description": description,
			"isPartOf": {
				"@id": `${origin}/#website`
			},
			"about": {
				"@id": `${origin}/#localbusiness`
			},
			"inLanguage": currentLang
		}
	]
};
---

<!doctype html>
<html lang={currentLang} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Canonical URL & Hreflang Alternates -->
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="fr" href={`${origin}/`} />
		<link rel="alternate" hreflang="es" href={`${origin}/es/`} />
		<link rel="alternate" hreflang="en" href={`${origin}/en/`} />
		<link rel="alternate" hreflang="x-default" href={`${origin}/`} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		<meta property="og:locale" content={localeMap[currentLang] || 'fr_FR'} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		
		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		
		<!-- Scroll Position Reset -->
		<script is:inline>
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}
			window.addEventListener('pageshow', () => {
				if (!window.location.hash) {
					window.scrollTo(0, 0);
				}
			});
		</script>
	</head>
	<body class="bg-cream-ivory text-slate-charcoal font-sans antialiased overflow-x-hidden selection:bg-balbux-soft selection:text-balbux-deep min-h-screen flex flex-col">
		<slot />
		<Toast />
		<Analytics />
	</body>
</html>
